# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# Latency levers. Measured on samples/sample2.pdf (9 pages): the defaults
# below give 12.8s to first event, 26.0s total.
#   OPENAI_SERVICE_TIER=fast   -> 7.4s / 13.0s, billed at 2x. Routing only,
#                                 so it does not change what the model computes.
#   OPENAI_REASONING_EFFORT=low -> 7.6s / 21.5s, free, but it DOES change the
#                                 computation - re-run test_live.py first.
# Empty sends nothing and lets the project/model default apply.
OPENAI_SERVICE_TIER=default
OPENAI_REASONING_EFFORT=

# Optional tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
